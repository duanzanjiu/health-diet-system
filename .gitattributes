# 统一换行符，避免 Windows/Linux 协作时整文件 diff
* text=auto eol=lf

# Windows 批处理必须用 CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# 二进制文件不参与换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.jar binary
*.woff binary
*.woff2 binary

# 语言统计（让 GitHub 正确识别项目语言）
*.java linguist-language=Java
*.vue  linguist-language=Vue
